{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/transfer.schema.json",
  "title": "Prospective transfer record",
  "type": "object",
  "required": [
    "prediction_results",
    "overall_assessment",
    "held_out_evidence_ids",
    "post_test_revision",
    "human_reviewed"
  ],
  "properties": {
    "prediction_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["prediction_id", "result", "reason"],
        "properties": {
          "prediction_id": {"type": "string"},
          "result": {"type": "string", "enum": ["supported", "failed", "indeterminate"]},
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "overall_assessment": {"type": "string", "minLength": 1},
    "held_out_evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "post_test_revision": {"type": "string"},
    "human_reviewed": {"type": "boolean"}
  },
  "additionalProperties": false
}
