{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/puzzle.schema.json",
  "title": "Puzzle record",
  "type": "object",
  "required": [
    "observed_pattern",
    "evidence_ids",
    "rival_descriptions",
    "unresolved_data_quality",
    "approved"
  ],
  "properties": {
    "observed_pattern": {"type": "string", "minLength": 1},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "rival_descriptions": {"type": "array", "items": {"type": "string"}},
    "unresolved_data_quality": {"type": "array", "items": {"type": "string"}},
    "approved": {"type": "boolean"}
  },
  "additionalProperties": false
}
