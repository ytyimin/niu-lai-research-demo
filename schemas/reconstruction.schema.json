{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/reconstruction.schema.json",
  "title": "Reconstruction record",
  "type": "object",
  "required": [
    "selected_mechanism",
    "explanatory_gain",
    "evidence_coverage",
    "rival_accounts",
    "observations_against",
    "prospective_transfer_predictions",
    "residual_anomalies",
    "locked",
    "held_out_opened"
  ],
  "properties": {
    "selected_mechanism": {"type": "string", "minLength": 1},
    "explanatory_gain": {"type": "string", "minLength": 1},
    "evidence_coverage": {"type": "object"},
    "rival_accounts": {"type": "array", "items": {"type": "string"}},
    "observations_against": {"type": "array", "items": {"type": "string"}},
    "prospective_transfer_predictions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["prediction_id", "claim"],
        "properties": {
          "prediction_id": {"type": "string"},
          "claim": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "residual_anomalies": {"type": "array", "items": {"type": "string"}},
    "locked": {"type": "boolean"},
    "held_out_opened": {"type": "boolean"}
  },
  "additionalProperties": false
}
